# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────
# Project URL + publishable (anon) key from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key — never expose via NEXT_PUBLIC_* or commit real value
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── Admin bootstrap ──────────────────────────────────
# Long random string used once to create the first Owner account.
# Generate: openssl rand -hex 32
ADMIN_SETUP_SECRET=

# ── Zoho Mail (SMTP outbound via Nodemailer) ─────────
# Port 465 uses implicit TLS (SECURE=true); port 587 uses STARTTLS (SECURE=false).
# Both work with Zoho — pick one pair, not a mix.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURE=false
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
# MUST be the same address as ZOHO_SMTP_USER, or a verified alias on that
# account's domain. Zoho refuses anything else at DATA with
# "550 5.7.1 Sender is not allowed to relay emails" — the login still succeeds,
# so the studio shows "connected" while every send fails.
ZOHO_MAIL_FROM=
ZOHO_MAIL_FROM_NAME=Adesua Oriaifo
# Where replies land. This may be a different domain — it is only a header.
ZOHO_MAIL_REPLY_TO=

# Zoho Mail API / IMAP (inbox access — separate from SMTP)
ZOHO_API_BASE_URL=https://mail.zoho.com/api
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993

# ── AI assistant (Zee) ───────────────────────────────
# Gemini Developer API key from https://aistudio.google.com/api-keys
AI_API_KEY=
# Optional: pin a model. Leave blank to use the built-in free-tier chain.
# Comma-separate to try several before the defaults.
AI_MODEL=
# Optional: extra models tried after AI_MODEL and before the built-in chain.
AI_MODEL_FALLBACKS=
# Built-in free-tier chain (used when the two above are empty):
#   gemini-3.8-flash → gemini-3.6-flash → gemini-3.5-flash-lite
#   → gemini-3.1-flash-lite → gemini-3-flash-preview
#   → gemini-2.5-flash → gemini-2.5-flash-lite
# A rate limit or retired model falls through to the next one automatically.
AI_MAX_TOKENS=400
AI_TEMPERATURE=0.6

# ── Web Push ─────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Notes
# - Never commit .env.local. Never print secret values in logs.
# - Never store SMTP passwords or AI API keys in database records.
